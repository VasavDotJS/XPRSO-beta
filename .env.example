# ==============================================================================
# XPRSO (Order Platform) - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Compatible with Neon, Supabase, or any standard PostgreSQL instance.
#
# A) NEON (Recommended for Vercel/Netlify):
#    1. Create a free database at https://neon.tech
#    2. Copy the pooled connection string (with ?sslmode=require)
#    Example:
#    DATABASE_URL=postgres://neondb_owner:npg_xxxx@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#    (Note: If deploying to Vercel with the Neon Marketplace Integration,
#     POSTGRES_URL is automatically injected and works out of the box!)
#
# B) SUPABASE:
#    1. Create a project at https://supabase.com
#    2. Go to Project Settings -> Database -> Connection string -> URI (Transaction pooler port 6543)
#    Example:
#    DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# C) LOCAL DOCKER:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orderplat

# ------------------------------------------------------------------------------
# 2. APPLICATION DOMAIN & ORIGIN (Optional on Vercel/Netlify - Auto-detected)
# ------------------------------------------------------------------------------
# In production on custom domains, set this to your domain without protocol:
# APP_DOMAIN=order.yourcafe.com
# On Vercel or Netlify, this is automatically resolved from VERCEL_URL / URL headers.
APP_DOMAIN=localhost:3000

# ------------------------------------------------------------------------------
# 3. SECURITY & TIMEZONE (Optional)
# ------------------------------------------------------------------------------
# Secret for session signing and cookies (min 32 characters)
SESSION_SECRET=super-secret-session-key-minimum-32-chars-long-xprso

# Default café operational timezone (IANA timezone name)
TZ_DEFAULT=Asia/Kolkata
